# =============================================================================
# IntelliFlow AI — Environment Variable Template
#
# USAGE:
#   cp .env.example .env
#   # Edit .env with your actual values
#
# RULES:
#   ✗ NEVER commit .env to version control
#   ✗ NEVER use development values in production
#   ✗ NEVER share secrets between environments
#   ✓ Generate unique secret values for each environment
#   ✓ Use a secrets manager (Vault, AWS Secrets Manager, etc.) in production
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="IntelliFlow AI"

# REQUIRED: Set to "production" in production environments
APP_ENV=development          # development | staging | production

APP_DEBUG=false
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — comma-separated list of allowed origins
# ⚠️  PRODUCTION: Set to your actual domain(s) — NEVER use localhost in production
# Example: CORS_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=intelliflow
POSTGRES_USER=intelliflow_user

# ⚠️  REQUIRED: Generate a strong password — NEVER use a default
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Full connection URL constructed from the above (used by SQLAlchemy & Alembic)
# ⚠️  REQUIRED: Update with your actual credentials
DATABASE_URL=

# Sync URL used only by Alembic migrations (not async)
DATABASE_SYNC_URL=

# -----------------------------------------------------------------------------
# Cache (Redis)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery (Background Jobs)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# ⚠️  REQUIRED: Generate a secure key — NEVER use the placeholder below
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# JWT signing algorithm
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Cookie Security
# ⚠️  PRODUCTION: Set COOKIE_SECURE=true and COOKIE_SAMESITE=strict
#     This requires HTTPS — do NOT set to true without HTTPS configured
# -----------------------------------------------------------------------------
COOKIE_SECURE=false          # MUST be true in production (requires HTTPS)
COOKIE_SAMESITE=lax          # Use "strict" in production

# -----------------------------------------------------------------------------
# Integration Credential Encryption (Fernet/AES)
# ⚠️  REQUIRED IN PRODUCTION: Generate a unique key for this purpose
# ⚠️  NEVER use the same value as JWT_SECRET_KEY
# ⚠️  Changing this key will make existing encrypted credentials unreadable
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#            or: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Webhook HMAC Signing Secret
# ⚠️  REQUIRED IN PRODUCTION: Generate a unique secret for webhook signing
# ⚠️  NEVER use the same value as JWT_SECRET_KEY or INTEGRATION_ENCRYPTION_KEY
# Generate with: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Storage & Uploads
# -----------------------------------------------------------------------------
STORAGE_DIR=/app/storage/documents
MAX_UPLOAD_SIZE_MB=25

# -----------------------------------------------------------------------------
# AI Assistant — Ollama LLM
# Model is NOT pulled automatically. Run manually:
#   docker compose exec ollama ollama pull llama3.2:1b
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# -----------------------------------------------------------------------------
# AI Assistant — Embeddings & FAISS
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=/app/data/faiss/index.faiss
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=8000

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# ⚠️  PRODUCTION: Set to your actual production API URL
# Example: NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
# Development: NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="IntelliFlow AI"
NEXT_PUBLIC_APP_ENV=development
