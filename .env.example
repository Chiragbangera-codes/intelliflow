# =============================================================================
# IntelliFlow AI — Environment Variable Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="IntelliFlow AI"
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=intelliflow
POSTGRES_USER=intelliflow_user
POSTGRES_PASSWORD=change_this_strong_password

# Full connection URL constructed from the above (used by SQLAlchemy & Alembic)
DATABASE_URL=postgresql+asyncpg://intelliflow_user:change_this_strong_password@postgres:5432/intelliflow

# Sync URL used only by Alembic migrations (not async)
DATABASE_SYNC_URL=postgresql+psycopg2://intelliflow_user:change_this_strong_password@postgres:5432/intelliflow

# -----------------------------------------------------------------------------
# Cache (Redis)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Celery (Background Jobs)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# -----------------------------------------------------------------------------
# JWT Authentication (Milestone 2)
# -----------------------------------------------------------------------------
# REQUIRED: Generate a secure key with: openssl rand -hex 32
# Minimum 32 characters. Must be changed in production.
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_characters_min

# JWT signing algorithm (HS256 is the default — use RS256 for asymmetric keys)
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Cookie Security (Milestone 2)
# Production: set COOKIE_SECURE=true and COOKIE_SAMESITE=strict
# Development: false/lax is acceptable
# -----------------------------------------------------------------------------
COOKIE_SECURE=false          # Set to true in production (HTTPS required)
COOKIE_SAMESITE=lax          # Use "strict" in production

# -----------------------------------------------------------------------------
# AI Assistant — Ollama LLM (Milestone 7)
# Model is NOT pulled automatically. Run manually:
#   docker compose exec ollama ollama pull llama3.1:8b
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# -----------------------------------------------------------------------------
# AI Assistant — Embeddings & FAISS (Milestone 7)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=/app/data/faiss/index.faiss
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=8000

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="IntelliFlow AI"
NEXT_PUBLIC_APP_ENV=development
